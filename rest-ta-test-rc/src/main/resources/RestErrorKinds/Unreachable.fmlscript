// CORE-F-11 phase 6 (REST-F-1): a select through the access point UnreachableAccessPoint fails with a typed technology error.
virtualModel = load -r ["http://openflexo.org/rest-test/RestErrorKinds.fml"];
accessPoint = load -r ["http://openflexo.org/rest-test/AccessPoints/UnreachableAccessPoint.rest"];
service ResourceCenterService add_temp_rc;
vmi = new RestErrorKinds(accessPoint.resource) with (name="Unreachable");
mustFail = vmi.userNamed("nobody");
